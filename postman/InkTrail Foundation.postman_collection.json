{
  "info": {
    "name": "InkTrail Foundation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:4177" },
    { "key": "novelId", "value": "11111111-1111-4111-8111-111111111111" }
  ],
  "item": [
    {
      "name": "Get health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/health" }
    },
    {
      "name": "List novels",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/novels" }
    },
    {
      "name": "Create novel",
      "request": {
        "method": "POST",
        "header": [{ "key": "content-type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Return of the War God\",\n  \"sourceUrl\": \"https://example.test/book/war-god\"\n}" },
        "url": "{{baseUrl}}/api/v1/novels"
      }
    },
    {
      "name": "Get novel",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/novels/{{novelId}}" }
    },
    {
      "name": "Record chapter",
      "request": {
        "method": "POST",
        "header": [{ "key": "content-type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"chapterNumber\": 1,\n  \"title\": \"Arrival\",\n  \"originalText\": \"Original Chinese\"\n}" },
        "url": "{{baseUrl}}/api/v1/novels/{{novelId}}/chapters"
      }
    },
    {
      "name": "Get reader chapter",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/novels/{{novelId}}/chapters/1" }
    },
    {
      "name": "Set reading progress",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "content-type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"chapterNumber\": 1\n}" },
        "url": "{{baseUrl}}/api/v1/novels/{{novelId}}/reading-progress"
      }
    }
  ]
}
