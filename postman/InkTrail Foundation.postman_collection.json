{
  "info": {
    "name": "InkTrail Foundation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run `pnpm start:source-fixture` before the source-import requests. That local server injects saved HTML and a deterministic fetch failure; it never requests Kujiang. Run Create novel first to set `novelId`."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:4278", "description": "Fixture-only server started by pnpm start:source-fixture." },
    { "key": "novelId", "value": "", "description": "Set by the Create novel request." },
    { "key": "missingNovelId", "value": "missing" },
    { "key": "fixtureSourceChapterUrl", "value": "https://www.kujiang.com/book/9/906595", "description": "Canonical Kujiang identity served from test/fixtures/kujiang/chapter.html by the local fixture server." },
    { "key": "fixtureSourceFetchFailureUrl", "value": "https://www.kujiang.com/book/9/906597", "description": "Canonical Kujiang identity that the local fixture server deterministically fails." },
    { "key": "unsupportedSourceUrl", "value": "https://example.test/chapter" }
  ],
  "item": [
    {
      "name": "Get health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/health" }
    },
    {
      "name": "List novels",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/novels" }
    },
    {
      "name": "Create novel",
      "request": {
        "method": "POST",
        "header": [{ "key": "content-type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Return of the War God\",\n  \"sourceUrl\": \"https://example.test/book/war-god\"\n}" },
        "url": "{{baseUrl}}/api/v1/novels"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": ["pm.collectionVariables.set('novelId', pm.response.json().id);"]
        }
      }]
    },
    {
      "name": "Get novel",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/novels/{{novelId}}" }
    },
    {
      "name": "Record chapter",
      "request": {
        "method": "POST",
        "header": [{ "key": "content-type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"chapterNumber\": 1,\n  \"title\": \"Arrival\",\n  \"originalText\": \"Original Chinese\"\n}" },
        "url": "{{baseUrl}}/api/v1/novels/{{novelId}}/chapters"
      }
    },
    {
      "name": "Import source chapter",
      "request": {
        "method": "POST",
        "header": [{ "key": "content-type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"sourceUrl\": \"{{fixtureSourceChapterUrl}}\",\n  \"chapterNumber\": 2491\n}" },
        "url": "{{baseUrl}}/api/v1/novels/{{novelId}}/source-chapters"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": ["pm.test('creates the fixture source chapter', () => pm.response.to.have.status(201));"]
        }
      }]
    },
    {
      "name": "Import source chapter - validation error",
      "request": {
        "method": "POST",
        "header": [{ "key": "content-type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"sourceUrl\": \"{{fixtureSourceChapterUrl}}\",\n  \"chapterNumber\": 0\n}" },
        "url": "{{baseUrl}}/api/v1/novels/{{novelId}}/source-chapters"
      }
    },
    {
      "name": "Import source chapter - unsupported source",
      "request": {
        "method": "POST",
        "header": [{ "key": "content-type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"sourceUrl\": \"{{unsupportedSourceUrl}}\",\n  \"chapterNumber\": 2491\n}" },
        "url": "{{baseUrl}}/api/v1/novels/{{novelId}}/source-chapters"
      }
    },
    {
      "name": "Import source chapter - novel not found",
      "request": {
        "method": "POST",
        "header": [{ "key": "content-type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"sourceUrl\": \"{{fixtureSourceChapterUrl}}\",\n  \"chapterNumber\": 2491\n}" },
        "url": "{{baseUrl}}/api/v1/novels/{{missingNovelId}}/source-chapters"
      }
    },
    {
      "name": "Import source chapter - conflict",
      "request": {
        "method": "POST",
        "header": [{ "key": "content-type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"sourceUrl\": \"{{fixtureSourceChapterUrl}}\",\n  \"chapterNumber\": 2492\n}" },
        "url": "{{baseUrl}}/api/v1/novels/{{novelId}}/source-chapters"
      }
    },
    {
      "name": "Import source chapter - source fetch failed",
      "request": {
        "method": "POST",
        "header": [{ "key": "content-type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"sourceUrl\": \"{{fixtureSourceFetchFailureUrl}}\",\n  \"chapterNumber\": 2491\n}" },
        "url": "{{baseUrl}}/api/v1/novels/{{novelId}}/source-chapters"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": ["pm.test('returns the stable fixture fetch failure', () => {", "  pm.response.to.have.status(502);", "  pm.expect(pm.response.json().error).to.deep.equal({ code: 'source_fetch_failed', message: 'Source chapter could not be fetched', retryable: true });", "});"]
        }
      }]
    },
    {
      "name": "Get reader chapter",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/novels/{{novelId}}/chapters/1" }
    },
    {
      "name": "Set reading progress",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "content-type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"chapterNumber\": 1\n}" },
        "url": "{{baseUrl}}/api/v1/novels/{{novelId}}/reading-progress"
      }
    }
  ]
}
